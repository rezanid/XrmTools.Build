<Project>
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <PackageId>Computed.$(MSBuildProjectName)</PackageId>
    <Version>5.6.7-beta</Version>
    <AssemblyVersion>5.6.7.0</AssemblyVersion>
    <FileVersion>5.6.7.0</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="RecordFixtureProducerBuild" AfterTargets="Build">
    <WriteLinesToFile File="$(IntermediateOutputPath)build-count.txt"
                      Lines="$(PackageId)|$(PackageVersion)|$(Version)|$(FileVersion)|$(FixtureDimension)|$(Configuration)"
                      Overwrite="false" />
  </Target>
  <Target Name="RejectFixturePack" BeforeTargets="Pack">
    <Error Text="Fixture: Phase 3 must not call Pack." />
  </Target>
</Project>
