<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props" />
  <PropertyGroup>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <TargetFramework>net462</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <OutputPath>$(MSBuildProjectDirectory)/bin/$(Configuration)/controls/</OutputPath>
    <PcfEnableAutoNpmInstall>false</PcfEnableAutoNpmInstall>
    <PcfAlwaysNpmRunBuild>true</PcfAlwaysNpmRunBuild>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Pcf" Version="2.14.1" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)/Microsoft.Common.targets" />
</Project>
