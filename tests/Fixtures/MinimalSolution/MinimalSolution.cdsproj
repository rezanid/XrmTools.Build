<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)/$(MSBuildToolsVersion)/Microsoft.Common.props" />

  <PropertyGroup>
    <ProjectGuid>{F010B57B-3C60-4E99-AC92-624B9C9C4B9D}</ProjectGuid>
    <TargetFrameworkVersion>v4.6.2</TargetFrameworkVersion>
    <TargetFramework>net462</TargetFramework>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <SolutionRootPath>src</SolutionRootPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.PowerApps.MSBuild.Solution" Version="2.14.1" />
    <PackageReference Include="XrmTools.Build" Version="0.5.0-phase6" PrivateAssets="all" />
    <PackageReference Include="Nerdbank.GitVersioning" Version="3.10.94" PrivateAssets="all"
                      Condition="'$(XrmToolsFixtureIncludeNbgv)' == 'true'" />
  </ItemGroup>

  <Target Name="PrintFixtureNbgvVersion" DependsOnTargets="GetBuildVersion">
    <Message Importance="High" Text="Fixture NBGV BuildVersion=$(BuildVersion)" />
  </Target>

  <Target Name="ObserveFixtureVersionBeforeStamp"
          BeforeTargets="XrmToolsResolveSolutionVersion"
          Condition="'$(XrmToolsFixtureCheckStamp)' != ''">
    <PropertyGroup>
      <_FixtureVersionBeforeStamp>$([System.IO.File]::GetLastWriteTime('$(SolutionPackagerMetadataWorkingDirectory)/Other/Solution.xml').Ticks)</_FixtureVersionBeforeStamp>
    </PropertyGroup>
  </Target>

  <Target Name="ObserveFixtureVersionAfterStamp"
          AfterTargets="XrmToolsResolveSolutionVersion"
          Condition="'$(XrmToolsFixtureCheckStamp)' != ''">
    <PropertyGroup>
      <_FixtureVersionAfterStamp>$([System.IO.File]::GetLastWriteTime('$(SolutionPackagerMetadataWorkingDirectory)/Other/Solution.xml').Ticks)</_FixtureVersionAfterStamp>
    </PropertyGroup>
    <Error Condition="'$(XrmToolsFixtureCheckStamp)' == 'Unchanged' and '$(_FixtureVersionBeforeStamp)' != '$(_FixtureVersionAfterStamp)'"
           Text="Fixture: XmlPoke rewrote an already matching staged version." />
    <Error Condition="'$(XrmToolsFixtureCheckStamp)' == 'Changed' and '$(_FixtureVersionBeforeStamp)' == '$(_FixtureVersionAfterStamp)'"
           Text="Fixture: XmlPoke did not stamp the differing staged version." />
  </Target>

  <Import Project="$(MSBuildToolsPath)/Microsoft.Common.targets" />
</Project>
