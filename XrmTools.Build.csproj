<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>XrmTools.Build</PackageId>
    <Version>0.5.0-phase6</Version>
    <Authors>XrmTools</Authors>
    <Description>Optional MSBuild extensions for Microsoft Dataverse solution projects.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Phase 6: contextual diagnostics, verified execution contracts, isolated parallel-build regressions and package-facing documentation. See docs/release-notes.md in this package.</PackageReleaseNotes>
    <RepositoryUrl>https://github.com/rezanid/XrmTools.Build</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="src/XrmTools.Build.Tasks/XrmTools.Build.Tasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="src/XrmTools.Build.AdapterTasks/XrmTools.Build.AdapterTasks.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" BuildReference="false" Private="false" SkipGetTargetFrameworkProperties="true" />
    <None Include="src/XrmTools.Build.AdapterTasks/bin/$(Configuration)/net8.0/XrmTools.Build.AdapterTasks.dll" Pack="true" PackagePath="tools/net8.0/" />
    <None Include="src/XrmTools.Build.AdapterTasks/bin/$(Configuration)/net472/XrmTools.Build.AdapterTasks.dll" Pack="true" PackagePath="tools/net472/" />
    <None Include="src/XrmTools.Build.Tasks/bin/$(Configuration)/netstandard2.0/XrmTools.Build.Tasks.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="src/XrmTools.Build.Tasks/bin/$(Configuration)/netstandard2.0/NuGet.Versioning.dll" Pack="true" PackagePath="tools/netstandard2.0/" />
    <None Include="build/XrmTools.Build.props" Pack="true" PackagePath="build/" />
    <None Include="build/XrmTools.Build.targets" Pack="true" PackagePath="build/" />
    <None Include="build/targets/*.targets" Pack="true" PackagePath="build/targets/" />
    <None Include="Sdk/*" Pack="true" PackagePath="Sdk/" Condition="'$(XrmToolsPrototypeSdk)' == 'true'" />
    <None Include="experiments/ProducerRecognition.targets" Pack="true" PackagePath="build/experiments/"
          Condition="'$(XrmToolsPrototypeRecognition)' == 'true'" />
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="LICENSE" Pack="true" PackagePath="licenses/" />
    <None Include="licenses/NuGet.Versioning.txt" Pack="true" PackagePath="licenses/" />
    <None Include="docs/architecture.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/artifact-discovery.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/plugin-package-staging.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/execution.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/development-dependency.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/troubleshooting.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/release-notes.md" Pack="true" PackagePath="docs/" />
    <None Include="docs/consumer-contract-prototype.md" Pack="true" PackagePath="docs/" />
    <None Include="examples/**/*" Exclude="examples/**/bin/**;examples/**/obj/**;examples/**/packages/**"
          Pack="true" PackagePath="examples/" />
    <None Include="docs/adr/0001-additive-nuget-build-extension.md" Pack="true" PackagePath="docs/adr/" />
    <None Include="docs/adr/0002-consumer-contract-prototype.md" Pack="true" PackagePath="docs/adr/" />
  </ItemGroup>
  <Target Name="ValidatePrototypePackageVersion" BeforeTargets="_GetOutputItemsFromPack;GenerateNuspec;Pack">
    <Error Condition="('$(XrmToolsPrototypeSdk)' == 'true' or '$(XrmToolsPrototypeRecognition)' == 'true') and '$(PackageVersion)' == '$(Version)'"
           Text="Prototype assets require a distinct PackageVersion to isolate NuGet resolution from the default package." />
  </Target>
  <Target Name="BuildPackAdapters" BeforeTargets="PrepareForBuild" Condition="'$(NoBuild)' != 'true'">
    <MSBuild Projects="src/XrmTools.Build.AdapterTasks/XrmTools.Build.AdapterTasks.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)"
             RemoveProperties="TargetFramework" />
  </Target>
</Project>
