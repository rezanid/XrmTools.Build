<Project>
  <UsingTask TaskName="XrmTools.Build.Tasks.PrepareProducers"
             AssemblyFile="$(MSBuildThisFileDirectory)../../tools/netstandard2.0/XrmTools.Build.Tasks.dll" />
  <UsingTask TaskName="XrmTools.Build.Tasks.ValidateArtifact"
             AssemblyFile="$(MSBuildThisFileDirectory)../../tools/netstandard2.0/XrmTools.Build.Tasks.dll" />
  <PropertyGroup>
    <_XrmToolsAdapterRuntime Condition="'$(MSBuildRuntimeType)' == 'Core'">net8.0</_XrmToolsAdapterRuntime>
    <_XrmToolsAdapterRuntime Condition="'$(MSBuildRuntimeType)' != 'Core'">net472</_XrmToolsAdapterRuntime>
  </PropertyGroup>
  <UsingTask TaskName="XrmTools.Build.Tasks.PreparePackAdapter"
             AssemblyFile="$(MSBuildThisFileDirectory)../../tools/$(_XrmToolsAdapterRuntime)/XrmTools.Build.AdapterTasks.dll" />

  <Target Name="_XrmToolsPreparePluginProducers"
          DependsOnTargets="XrmToolsGetPluginPackageProjects;ResolveProjectReferences">
    <XrmTools.Build.Tasks.PrepareProducers Producers="@(XrmToolsPluginPackageProject)"
                                         ResolvedReferences="@(_MSBuildProjectReferenceExistent)">
      <Output TaskParameter="Prepared" ItemName="_XrmToolsProducer" />
    </XrmTools.Build.Tasks.PrepareProducers>
  </Target>

  <!-- Outputs supplies target batching only; no fake stamp or incremental artifact selection. -->
  <Target Name="_XrmToolsDiscoverPluginPackage"
          DependsOnTargets="_XrmToolsPreparePluginProducers"
          Outputs="%(_XrmToolsProducer.Identity)"
          Condition="'@(_XrmToolsProducer)' != ''">
    <ItemGroup>
      <_XrmToolsContractOutput Remove="@(_XrmToolsContractOutput)" />
      <_XrmToolsAdapterOutput Remove="@(_XrmToolsAdapterOutput)" />
      <_XrmToolsFrameworks Remove="@(_XrmToolsFrameworks)" />
      <_XrmToolsPackProducer Remove="@(_XrmToolsPackProducer)" />
    </ItemGroup>
    <MSBuild Projects="@(_XrmToolsProducer)" Targets="GetTargetFrameworks"
             Properties="%(_XrmToolsProducer.SetConfiguration);%(_XrmToolsProducer.SetPlatform)"
             RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework;RuntimeIdentifier;SelfContained"
             SkipNonexistentTargets="true">
      <Output TaskParameter="TargetOutputs" ItemName="_XrmToolsFrameworks" />
    </MSBuild>
    <!-- A normal assembly reference builds only its nearest TFM; packing needs all producer TFMs. -->
    <MSBuild Projects="@(_XrmToolsProducer)" Targets="Build"
             Properties="%(_XrmToolsProducer.SetConfiguration);%(_XrmToolsProducer.SetPlatform)"
             RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework"
             Condition="'$(BuildProjectReferences)' != 'false' and '@(_XrmToolsFrameworks->'%(HasSingleTargetFramework)')' == 'false'" />
    <Message Importance="Low" Text="XrmTools.Build: packing %(_XrmToolsProducer.Identity). A working Pack target is required; restore producer dependencies before building. Package output paths and NuGet versions are owned by the producer." />
    <XrmTools.Build.Tasks.PreparePackAdapter Producer="@(_XrmToolsProducer)"
        AdapterPath="$(MSBuildThisFileDirectory)ProducerPackAdapter.targets"
        RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework;XrmToolsSolutionVersion;XrmToolsResolvedSolutionVersion">
      <Output TaskParameter="Prepared" ItemName="_XrmToolsPackProducer" />
    </XrmTools.Build.Tasks.PreparePackAdapter>
    <MSBuild Projects="@(_XrmToolsPackProducer)" Targets="Pack"
             Properties="%(_XrmToolsProducer.SetConfiguration);%(_XrmToolsProducer.SetPlatform);NoBuild=true"
             RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework;XrmToolsSolutionVersion;XrmToolsResolvedSolutionVersion"
             ContinueOnError="ErrorAndContinue">
      <Output TaskParameter="TargetOutputs" ItemName="_XrmToolsIgnoredPackOutput" />
    </MSBuild>
    <Error Code="XTB3000" Condition="'$(MSBuildLastTaskResult)' != 'true'"
           Text="XrmTools.Build: Pack failed for %(_XrmToolsProducer.Identity). Ensure the producer provides Pack and its dependencies are restored; artifact overrides do not bypass producer packaging." />
    <MSBuild Projects="@(_XrmToolsPackProducer)" Targets="XrmToolsGetPluginPackageArtifact"
             Properties="%(_XrmToolsProducer.SetConfiguration);%(_XrmToolsProducer.SetPlatform);NoBuild=true"
             RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework;XrmToolsSolutionVersion;XrmToolsResolvedSolutionVersion"
             SkipNonexistentTargets="true"
             Condition="'%(_XrmToolsProducer.XrmToolsPluginPackagePath)' == ''">
      <Output TaskParameter="TargetOutputs" ItemName="_XrmToolsContractOutput" />
    </MSBuild>
    <MSBuild Projects="@(_XrmToolsPackProducer)" Targets="_XrmToolsGetPackEvidence"
             Properties="%(_XrmToolsProducer.SetConfiguration);%(_XrmToolsProducer.SetPlatform);NoBuild=true"
             RemoveProperties="%(_XrmToolsProducer.GlobalPropertiesToRemove);$(_GlobalPropertiesToRemoveFromProjectReferences);TargetFramework;XrmToolsSolutionVersion;XrmToolsResolvedSolutionVersion"
             SkipNonexistentTargets="true"
             Condition="('%(_XrmToolsProducer.XrmToolsPluginPackagePath)' == '' and '@(_XrmToolsContractOutput)' == '') or ('%(_XrmToolsProducer.XrmToolsPluginPackagePath)' != '' and ('%(_XrmToolsProducer.XrmToolsPluginPackageId)' == '' or '%(_XrmToolsProducer.XrmToolsPluginPackageVersion)' == ''))">
      <Output TaskParameter="TargetOutputs" ItemName="_XrmToolsAdapterOutput" />
    </MSBuild>
    <XrmTools.Build.Tasks.ValidateArtifact Producer="@(_XrmToolsProducer)"
                                          SolutionDirectory="$(MSBuildProjectDirectory)"
                                          ContractOutputs="@(_XrmToolsContractOutput)"
                                          AdapterOutputs="@(_XrmToolsAdapterOutput)">
      <Output TaskParameter="Artifacts" ItemName="XrmToolsPluginPackageArtifact" />
    </XrmTools.Build.Tasks.ValidateArtifact>
  </Target>

  <Target Name="XrmToolsDiscoverPluginPackages"
          BeforeTargets="PowerAppsPackage"
          DependsOnTargets="_XrmToolsPreparePluginProducers;_XrmToolsDiscoverPluginPackage"
          Returns="@(XrmToolsPluginPackageArtifact)"
          Condition="'$(MSBuildProjectExtension)' == '.cdsproj' and '$(DesignTimeBuild)' != 'true'" />
</Project>
